# Copiá este archivo como ".env" y completá los valores.
# El .env está en .gitignore: tus claves nunca se suben a git.
# En producción, estas mismas variables se cargan en el panel del hosting.

# --- Producción (servidor) ---
# Tu dominio, sin https:// (ej: ggaming.duckdns.org). Lo usan Caddy (HTTPS) y la app.
DOMINIO=

# --- Tienda ---
# Número del BOT (al que escriben los clientes desde el botón "Enviar por WhatsApp")
WHATSAPP_NUMBER=5493515599430
BASE_URL=http://localhost:8080

# --- Panel admin ---
ADMIN_USER=admin
ADMIN_PASSWORD=
# Texto largo y aleatorio (firma la cookie "recordarme")
SECRET_KEY=
# true en producción (con HTTPS)
COOKIE_SECURE=false

# --- IA (Google AI Studio: https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Si el principal se queda sin cuota, se usa este automáticamente
GEMINI_MODELO_RESPALDO=gemini-3.5-flash-lite
# Buscar precios actuales en Google. En el plan gratuito agota la cuota al primer
# uso: dejalo en false salvo que actives la facturación en Google AI Studio.
GEMINI_BUSQUEDA=false

# --- Bot de WhatsApp (Meta: developers.facebook.com → tu app → WhatsApp → Configuración de la API) ---
# Token de acceso permanente (usuario del sistema en Meta Business)
WHATSAPP_TOKEN=
# "Identificador del número de teléfono" (un id numérico, NO el número)
WHATSAPP_PHONE_NUMBER_ID=
# Una palabra secreta que inventás vos y cargás también en Meta al configurar el webhook
WHATSAPP_VERIFY_TOKEN=
# "Clave secreta de la app" (Configuración de la app → Básica). Valida que los mensajes vienen de Meta
WHATSAPP_APP_SECRET=
# Tu WhatsApp personal: ahí llegan los avisos de turnos y consultas
DUENO_WHATSAPP=5493834507890
# Opcional: plantillas aprobadas por Meta para que los avisos lleguen aunque no le hayas
# escrito al bot en las últimas 24 hs. Sin plantillas, mandale "hola" al bot una vez por día.
WHATSAPP_PLANTILLA_CONSULTA=
WHATSAPP_PLANTILLA_TURNO=
# Horas que el bot se queda callado en un chat después de derivártelo
BOT_HORAS_PAUSA=12

# --- Datos de la tienda que usa el bot (vacío = los valores por defecto) ---
# TIENDA_DIRECCION=Bv. Chacabuco 651, Nueva Córdoba, Córdoba
# TIENDA_APERTURA=08:00
# TIENDA_CIERRE=21:00
